{
  "name": "tailorpro",
  "version": "0.1.0",
  "description": "TailorPro",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,realtime,storage-api",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "test:integration": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "node scripts/local-env.mjs && next build && node scripts/make-sw.mjs",
    "e2e": "npm run build && playwright test",
    "lint": "eslint app src tests",
    "build:app": "next build && node scripts/make-sw.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliabarume-zawadie/TailorPro.git"
  },
