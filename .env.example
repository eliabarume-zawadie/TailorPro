# Local development: `npm run build` writes .env.local from the running Supabase stack (public values only).
# Hosted staging/production: set these in the hosting provider. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only: configured in Supabase (local file supabase/.env, hosted dashboard). Never in the app bundle.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
